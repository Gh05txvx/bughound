.vscode/

# UI reference images (used internally as a design reference, do not commit)
ref/

# Local scan output (per-target working reports, not source, do not commit to a public repo)
hasil scan/

# Claude Code: session data, memory, & local settings (transcript + settings.local.json), do not commit, least of all to a public repo
.claude/

# Plugin skills/agents (third-party skill cache + lock file), tooling artifacts, not product code; local only
/.agents/
/skills-lock.json

